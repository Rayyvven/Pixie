[node name="ChangeLogRich" type="RichTextLabel" parent="CanvasLayer/PauseMenu/ChangeLogBase" unique_id=1803462898]
z_index = 99
layout_mode = 0
offset_right = 712.0
offset_bottom = 914.0
theme_override_font_sizes/normal_font_size = 32
text = "Changelog v0.1.1
Additions:
 - New rotate ability for slide tiles!
 - New background video feature for tracks
 - New created level browser
 - New themed buttons, fonts, icons, colors & more!
 - New save & import systems!
 - Adjusted the game such that it can now run on any aspect ratio. Please report any issues directly!
 - Implimented a very basic Discord RPC system.
 - Revamped the options menu, introducing Scroll Strength, Background Blur, Max FPS, VSync, and fullscreen options! The options menu will now be the same no matter where you are in Pixie.
Bug Fixes & Improvements:
 - A lot of under the hood changes to how slide tiles work
 - Fixed a bug in which track names would not save
 - Script optimizations, junk removal, file reduction
 - Fixed speed, description, artist, BPM and more values not saving properly.
 - With the new track saving system, users on Android will no longer have to use the old, copy and paste based system to save their tracks.
 - Fixed options saving logic
 - The background color now accurately exports and imports.
 - \"Row Control\" is now only visible when the \"Updated Row Calculation\" experimental option is enabled.
 - Background videos now accurately save & load
"

