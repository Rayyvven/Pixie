[sub_resource type="GDScript" id="GDScript_hppm4"]
script/source = "extends VScrollBar

@onready var play: TextureButton = $\"../Yikes/Play\"
@onready var speed_val: LineEdit = $\"../OptionsMenu/OptionsPanel/MainVerticalContainer/Row 5/SpeedVal\"
@onready var length_label: Label = $\"../OptionsMenu/OptionsPanel/MainVerticalContainer/Row 3/SongFile/Length Label\"
@onready var play_position: Button = $\"../../PlayPosition\"
@onready var scroll: LineEdit = $\"../PauseMenu/PauseEditorOptions/EditorPauseMenu/EditorPauseSettingsPanel/VBoxContainer/Row 4/Scroll\"


var new_max = 0.0

func _process(delta: float) -> void:
	if new_max != max_value:
		max_value = float(length_label.length)*float(speed_val.text)
		new_max = max_value
		value = max_value
		LevelController.LevelData[\"Level Info\"][\"Length\"] = max_value
		play_position.position.y = 720.0 + value
	max_value = float(length_label.length)*float(speed_val.text)

func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseButton:
		if event.is_pressed():
			if event.button_index == MOUSE_BUTTON_WHEEL_DOWN:
				value += int(scroll.text) * event.factor
			if event.button_index == MOUSE_BUTTON_WHEEL_UP:
				value -= int(scroll.text) * event.factor
"

